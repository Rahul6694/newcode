ENV['RCT_NEW_ARCH_ENABLED'] = '0'

require Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]
).strip

platform :ios, min_ios_version_supported
use_modular_headers!

prepare_react_native_project!

# Firebase + Google Maps need static frameworks
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# react-native-permissions
def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    ['-p', "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]
  ).strip
end

node_require('react-native-permissions/scripts/setup.rb')

target 'AtceDriver' do
  config = use_native_modules!

  # --------------------
  # Maps
  # --------------------
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps', :path => rn_maps_path
  pod 'react-native-maps/Google', :path => rn_maps_path

  pod 'GoogleMaps'
  pod 'Google-Maps-iOS-Utils'

  # --------------------
  # Push Notifications
  # --------------------
  pod 'RNCPushNotificationIOS', :path => '../node_modules/@react-native-community/push-notification-ios'

  # Firebase Messaging (FCM)
  pod 'Firebase/Messaging'

  # --------------------
  # Permissions
  # --------------------
  setup_permissions([
    'Camera',
    'PhotoLibrary',
    'PhotoLibraryAddOnly',
    'LocationWhenInUse',
    'LocationAlways',
  ])

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Fix arm64 simulator issues (Apple Silicon)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end
  end
end
